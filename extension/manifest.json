{
  "manifest_version": 3,
  "name": "AI Chat Highlighter",
  "version": "0.6.8",
  "description": "Highlight, save, organize, and sync important passages across ChatGPT, Claude, Gemini, and more.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "action": { "default_title": "AI Chat Highlighter", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*"
    ],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}